        {
          "name": "Create Text Goat",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has goat data\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.message).to.include(\"created successfully\");",
                  "    pm.expect(responseJson.goat).to.be.an('object');",
                  "    pm.expect(responseJson.goat.name).to.eql(\"test_text_goat\");",
                  "    pm.expect(responseJson.goat.type).to.eql(\"text\");",
                  "    ",
                  "    // Store goat name for later tests",
